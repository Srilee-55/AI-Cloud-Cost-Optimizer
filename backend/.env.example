# Environment Configuration
PROJECT_NAME="AI Cloud Cost Optimizer"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL default; fallback to SQLite if DB not reachable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloud_optimizer_db
# SQLite fallback: sqlite:///./cloud_optimizer.db

# JWT & Authentication
SECRET_KEY=dev-super-secret-key-change-in-production-2026-optimizer
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
