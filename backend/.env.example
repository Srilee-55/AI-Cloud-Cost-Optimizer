# ==========================================
# AI Cloud Cost Optimizer — Environment Config
# ==========================================

# 1. Database Configuration (Supabase PostgreSQL)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# 2. Supabase API Credentials
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Google Gemini AI API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 4. JWT Authentication
JWT_SECRET=dev-super-secret-key-change-in-production-2026-optimizer
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# 5. Application Settings
PROJECT_NAME="AI Cloud Cost Optimizer"
ENVIRONMENT="development"
DEBUG=True
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
